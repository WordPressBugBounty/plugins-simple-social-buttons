            "Enter a whole number of pixels from 1 to 999. The value was adjusted.": [
                "\u012eveskite vis\u0105 skai\u010di\u0173 pikseli\u0173 nuo 1 iki 999. Vert\u0117 buvo koreguota."
            ],
            "Select...": [
                "Pasirinkti..."
            ],
            "<strong>Simple Social Buttons<\/strong> by <strong><a href=\"https:\/\/wpbrigade.com\/?utm_source=simple-social-buttons-lite&utm_medium=link-header&utm_campaign=pro-upgrade\">WPBrigade<\/a><\/strong> adds an advanced set of social media sharing buttons to your WordPress sites, such as: <strong>Facebook<\/strong>, <strong>Twitter\/X<\/strong>, <strong>LinkedIn<\/strong>, <strong>WhatsApp<\/strong>, <strong>Viber<\/strong>, <strong>Reddit<\/strong> and <strong>Pinterest<\/strong>. This makes it the most flexible social sharing plugin for everyone.": [
                "<strong>Papras\u010di\u0173 socialini\u0173 mygtuk\u0173<\/strong> k\u016br\u0117jas <strong><a href=\"https:\/\/wpbrigade.com\/?utm_source=simple-social-buttons-lite&utm_medium=link-header&utm_campaign=pro-upgrade\">WPBrigade<\/a><\/strong> prideda pa\u017eangi\u0105 socialini\u0173 tinkl\u0173 dalijimosi mygtuk\u0173 rinkin\u012f j\u016bs\u0173 WordPress svetain\u0117ms, tokias kaip: <strong>Facebook<\/strong>, <strong>Twitter\/X<\/strong>, <strong>LinkedIn<\/strong>, <strong>WhatsApp<\/strong>, <strong>Viber<\/strong>, <strong>Reddit<\/strong> ir <strong>Pinterest<\/strong>. Tai daro j\u012f labiausiai lanks\u010diu socialinio dalijimosi papildiniu visiems."
            ],
            "Control how share buttons appear on images and media within your posts.": [
                "Valdykite, kaip dalijimosi mygtukai atrodo j\u016bs\u0173 \u012fra\u0161uose esan\u010diose nuotraukose ir medijoje."
            ],
            "Configure your share popup: set the message, timing, and trigger behavior.": [
                "Konfig\u016bruokite savo dalijimosi i\u0161\u0161okant\u012f lang\u0105: nustatykite prane\u0161im\u0105, laik\u0105 ir aktyvavimo elges\u012f."
            ],
            "Set up a slide-in share prompt with custom messaging, position, and timing": [
                "Sukurkite slenkant\u012f dalijimosi prane\u0161im\u0105 su individualizuotu prane\u0161imu, pozicija ir laiku"
            ],
            "HTTP\/HTTPS Counts Resolve": [
                "HTTP\/HTTPS skai\u010diavimai"
            ],
            "hour": [
                "valanda"
            ],
            "hours": [
                "valandos"
            ],
            "Internal share click counts are recorded for supported networks (for example Twitter\/X, LinkedIn, WhatsApp) when visitors use the sharing buttons on your site. Counts are stored locally and are not sent to those social networks. Clear your page cache after upgrading the plugin so button markup stays in sync.": [
                "Vidiniai dalijimosi paspaudim\u0173 skai\u010diai yra fiksuojami palaikomose socialin\u0117se tinkluose (pvz., Twitter\/X, LinkedIn, WhatsApp), kai lankytojai naudoja dalijimosi mygtukus j\u016bs\u0173 svetain\u0117je. Skai\u010diai saugomi lokaliai ir n\u0117ra siun\u010diami \u012f \u0161ias socialines tinklus. I\u0161valykite savo puslapio talpykl\u0105 po papildinio atnaujinimo, kad mygtuk\u0173 \u017eym\u0117jimas i\u0161likt\u0173 suderintas."
            ],
            "Enable to remove all settings upon uninstalling the plugin.": [
                "\u012ejungti, kad pa\u0161alintum\u0117te visus nustatymus, pa\u0161alinus papildin\u012f."
            ],
            "Enable to reset all settings back to default upon saving.": [
                "\u012ejungti, kad atstatytum\u0117te visus nustatymus \u012f numatytuosius, kai i\u0161saugote."
            ],
            "Click To Post": [
                "Paspauskite, kad paskelbtum\u0117te"
            ],
            "Unlock Click to Tweet Feature with Pro!": [
                "Atrakinkite Paspauskite, kad Tweet funkcij\u0105 su Pro!"
            ],
            "Get the powerful Click to Tweet functionality that lets you create engaging, tweetable content directly in your posts. This Pro feature helps increase social engagement and drive more traffic to your site.": [
                "Gaukite galing\u0105 Paspauskite, kad Tweet funkcionalum\u0105, leid\u017eiant\u012f kurti \u012ftraukian\u010di\u0105, tweetinam\u0105 turin\u012f tiesiai savo \u012fra\u0161uose. \u0160i Pro funkcija padeda padidinti socialin\u012f \u012fsitraukim\u0105 ir pritraukti daugiau srauto \u012f j\u016bs\u0173 svetain\u0119."
            ],
            "Click here to Upgrade": [
                "Paspauskite \u010dia, kad atnaujintum\u0117te"
            ],
            "Loading Pro settings...": [
                "Kraunamos Pro nustatymai..."
            ],
            "Loading Pro component...": [
                "Kraunamas Pro komponentas..."
            ],
            "Configure how your inline share buttons appear within your content.": [
                "Konfig\u016bruokite, kaip j\u016bs\u0173 vidiniai dalijimosi mygtukai atrodo j\u016bs\u0173 turinyje."
            ],
            "For Facebook share count you need to add Facebook App ID and Secret in the Social tab.": [
                "Norint gauti Facebook dalijimosi skai\u010di\u0173, reikia prid\u0117ti Facebook Program\u0117l\u0117s ID ir Slapta\u017eod\u012f Socialiniame skirtuke."
            ],
            "Show only a set number of icons in your content. Remaining icons open in a popup when visitors tap the + button.": [
                "Rodyti tik nustatyt\u0105 ikon\u0173 skai\u010di\u0173 j\u016bs\u0173 turinyje. Likusios ikon\u0117l\u0117s atsidaro i\u0161\u0161okan\u010diame lange, kai lankytojai paspaud\u017eia + mygtuk\u0105."
            ],
            "This text appears on your site as a heading above the inline share buttons. It is not used as the title when someone shares your content on social networks.": [
                "\u0160is tekstas rodomas j\u016bs\u0173 svetain\u0117je kaip antra\u0161t\u0117 vir\u0161 inline dalijimosi mygtuk\u0173. Jis nenaudojamas kaip pavadinimas, kai kas nors dalijasi j\u016bs\u0173 turiniu socialiniuose tinkluose."
            ],
            "Press Enter to move to Inactive.": [
                "Paspauskite Enter, kad pereitum\u0117te prie Neaktyvus."
            ],
            "Press Enter to move to Active.": [
                "Paspauskite Enter, kad pereitum\u0117te prie Aktyvus."
            ],
            "Use Up and Down arrow keys to reorder.": [
