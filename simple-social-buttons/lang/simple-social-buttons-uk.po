msgid "Purge caches (30 recent posts/pages)"
msgstr "Очистити кеш (30 останніх записів/сторінок)"

#: classes/class-ssb-admin-bar-purge.php:99
msgid "Purge all (internal + API cache)"
msgstr "Очистити всі (внутрішній + API кеш)"

#: classes/class-ssb-admin-bar-purge.php:124
msgid "You do not have permission to purge share caches."
msgstr "У вас немає дозволу на очищення кешу спільних записів."

#: classes/class-ssb-admin-bar-purge.php:181
#: classes/class-ssb-admin-bar-purge.php:313
msgid "Purging all share caches in the background…"
msgstr "Очищення всіх кешів спільних записів у фоновому режимі…"

#: classes/class-ssb-admin-bar-purge.php:217
#. translators: 1: posts processed, 2: internal queue flushes.
msgid ""
"Purged %1$d posts/pages. Internal queue flushed for %2$d. No posts found "
"for API refetch."
msgstr ""
"Очищено %1$d записів/сторінок. Внутрішня черга очищена для %2$d. Записів не "
"знайдено для повторного запиту API."

#: classes/class-ssb-admin-bar-purge.php:230
msgid "Internal share queue flushed. No posts found for API refetch."
msgstr ""
"Внутрішня черга спільних записів очищена. Записів не знайдено для "
"повторного запиту API."

#: classes/class-ssb-admin-bar-purge.php:253
#. translators: %d: number of posts.
msgid "Purging share caches for %d recent posts/pages in the background…"
msgstr ""
"Очищення кешів спільних записів для %d останніх записів/сторінок у фоновому "
"режимі…"

#: classes/class-ssb-admin-bar-purge.php:274
msgid "Purge all is not enabled on this site."
msgstr "Очистка всіх не увімкнена на цьому сайті."

#: classes/class-ssb-admin-bar-purge.php:341
msgid "The background purge could not be scheduled. Please try Purge All again."
msgstr ""
"Фонове очищення не вдалося запланувати. Будь ласка, спробуйте очистити всі "
"ще раз."

#: classes/class-ssb-admin-bar-purge.php:355
#. translators: 1: posts processed, 2: internal queue flushes, 3: API refetches.
msgid ""
"Purged %1$d posts/pages. Internal queue flushed for %2$d. API counts "
"refetched for %3$d."
msgstr ""
"Очищено %1$d записів/сторінок. Внутрішня черга очищена для %2$d. API дані "
"повторно запитані для %3$d."

#: classes/class-ssb-admin-bar-purge.php:366
#. translators: %d: number of posts.
msgid "Purge all complete. API counts refetched for %d posts/pages."
msgstr "Очистка всіх завершена. API дані повторно запитані для %d записів/сторінок."

#: classes/class-ssb-admin-bar-purge.php:445
#. translators: 1: done count, 2: total count.
msgid "(%1$d / %2$d posts)"
msgstr "(%1$d / %2$d записів)"

